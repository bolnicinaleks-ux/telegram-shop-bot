# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Необязательно: ID рабочей группы для заказов (бот должен быть её участником, ID вида -100...).
# Если пусто — заказы приходят каждому администратору в личку.
ORDERS_CHAT_ID=

DB_PATH=data/bot.db
TIMEZONE=Asia/Almaty
CURRENCY=₸
SHOP_NAME=Наш магазин

# Реквизиты оплаты, показываются клиенту после оформления. \n — перенос строки.
PAYMENT_INFO=Оплата переводом на Kaspi: +7 700 000 00 00 (Иван И.)\nили наличными при получении.
PICKUP_ADDRESS=г. Алматы, ул. Абая, 1

# Доставка: 0 — выключена (только самовывоз)
DELIVERY_ENABLED=1
DELIVERY_PRICE=1000
# Бесплатная доставка от суммы (0 — нет)
FREE_DELIVERY_FROM=20000

# Минимальная сумма заказа (0 — без ограничения)
MIN_ORDER=0
# Не больше N заказов в час от одного клиента
MAX_ORDERS_PER_HOUR=5

# Демо-режим: без реквизитов оплаты; клиент после заказа получает копию карточки владельца и может менять статус своего заказа
DEMO_MODE=0

# Язык интерфейса: ru или en (для английской версии запускайте отдельный экземпляр со своим токеном)
BOT_LANG=ru
